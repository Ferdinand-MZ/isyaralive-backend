# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ==========================
# Virtual environment
# ==========================
venv/
env/
.venv/
ENV/

# ==========================
# Environment variables / secrets
# ==========================
.env
.env.*
!.env.example

# ==========================
# Database
# ==========================
database.db
database.db.bak
*.sqlite3
*.db-journal

# ==========================
# Konten upload pengguna (video kontribusi SignHub)
# Tidak ikut repo: ini data user, bisa besar, dan berubah terus.
# ==========================
uploads/pending/*
uploads/approved/*
uploads/rejected/*
uploads/chat_videos/*
!uploads/*/.gitkeep

# ==========================
# ASET PERAGA — IKUT REPO
# Video abjad A-Z dan video kamus SignPedia adalah bagian dari aplikasi,
# bukan data user. Tanpa ini, siapa pun yang clone repo tidak bisa
# menjalankan fitur teks-ke-gestur sama sekali.
#
# Tidak ada aturan ignore untuk assets/ — semua file di dalamnya ikut
# ter-commit. Baris di bawah hanya membuang berkas sampah dari editor
# video / OS yang sering ikut nyelip.
# ==========================
assets/**/*.tmp
assets/**/.DS_Store
assets/**/Thumbs.db
assets/**/*.mp4.part

# Kalau ada video mentah beresolusi besar yang belum dikompres,
# taruh di folder ini supaya tidak ikut ter-commit:
assets/_raw/

# ==========================
# Cache hasil ekstraksi landmark
# Bisa dibuat ulang kapan saja dengan:
#   python scripts/build_animation_cache.py
# Jadi tidak perlu ikut repo.
# ==========================
cache/

# ==========================
# Model & artefak ML
#
# hand_landmarker.task (7,5 MB) TIDAK ikut repo — file ini otomatis
# terunduh sendiri saat backend pertama kali dijalankan.
#
# lstm_model.pt (952 KB), label_encoder.pkl (3 KB), dan model_config.json
# IKUT repo. Ukurannya kecil, dan ketiganya wajib ada supaya backend bisa
# jalan. Kalau di-ignore, setiap anggota tim harus menyalin manual dari
# Drive dan gampang tertukar versi — persis masalah yang bikin backend
# diam-diam masuk dummy mode.
# ==========================
models/*.task
models/*.onnx
models/*.h5
models/checkpoints/
!models/.gitkeep

# ==========================
# Notebook
# ==========================
.ipynb_checkpoints/

# ==========================
# Editor / OS
# ==========================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================
# Logs
# ==========================
*.log
logs/

# ==========================
# Testing / coverage
# ==========================
.pytest_cache/
.coverage
htmlcov/